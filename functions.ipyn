Absolutely. Here is **all 35 examples in one copy-ready Python code block**, with comments separating each topic.

```python
# ============================================================
# PYTHON FUNCTIONS, MAP, FILTER, REDUCE, WHILE, BREAK, CONTINUE
# ============================================================


# ============================================================
# 1. FUNCTIONS - 5 EXAMPLES
# ============================================================

# Example 1 - Basic Function
def greet():
    print("Hello, Welcome to Python!")

greet()


# Example 2 - Function with Parameters
def greet_name(name):
    print("Hello", name)

greet_name("Shaikh")


# Example 3 - Function with Return
def add(a, b):
    return a + b

result = add(10, 20)
print(result)


# Example 4 - Check Even Number
def is_even(number):
    return number % 2 == 0

print(is_even(10))
print(is_even(7))


# Example 5 - Default Parameter
def greet_student(name="Student"):
    print("Hello", name)

greet_student()
greet_student("Shaikh")


# ============================================================
# 2. MAP() - 5 EXAMPLES
# ============================================================

# Example 1 - Double Numbers
numbers = [1, 2, 3, 4, 5]

result = list(map(lambda x: x * 2, numbers))

print(result)


# Example 2 - Square Numbers
numbers = [1, 2, 3, 4, 5]

result = list(map(lambda x: x ** 2, numbers))

print(result)


# Example 3 - Convert Names to Uppercase
names = ["shaikh", "rahul", "amit"]

result = list(map(str.upper, names))

print(result)


# Example 4 - Add 10 to Every Number
numbers = [10, 20, 30, 40]

result = list(map(lambda x: x + 10, numbers))

print(result)


# Example 5 - Convert Strings to Integers
numbers = ["10", "20", "30", "40"]

result = list(map(int, numbers))

print(result)


# ============================================================
# 3. FILTER() - 5 EXAMPLES
# ============================================================

# Example 1 - Even Numbers
numbers = [1, 2, 3, 4, 5, 6]

result = list(filter(lambda x: x % 2 == 0, numbers))

print(result)


# Example 2 - Odd Numbers
numbers = [1, 2, 3, 4, 5, 6]

result = list(filter(lambda x: x % 2 != 0, numbers))

print(result)


# Example 3 - Numbers Greater Than 10
numbers = [5, 12, 8, 20, 15]

result = list(filter(lambda x: x > 10, numbers))

print(result)


# Example 4 - Names Starting With A
names = ["Amit", "Rahul", "Ankit", "Priya"]

result = list(filter(lambda name: name.startswith("A"), names))

print(result)


# Example 5 - Positive Numbers
numbers = [-5, 10, -2, 8, 0, 15]

result = list(filter(lambda x: x > 0, numbers))

print(result)


# ============================================================
# 4. REDUCE() - 5 EXAMPLES
# ============================================================

from functools import reduce


# Example 1 - Sum of Numbers
numbers = [1, 2, 3, 4, 5]

result = reduce(lambda a, b: a + b, numbers)

print(result)


# Example 2 - Product of Numbers
numbers = [1, 2, 3, 4, 5]

result = reduce(lambda a, b: a * b, numbers)

print(result)


# Example 3 - Find Maximum
numbers = [10, 25, 5, 40, 15]

result = reduce(lambda a, b: a if a > b else b, numbers)

print(result)


# Example 4 - Find Minimum
numbers = [10, 25, 5, 40, 15]

result = reduce(lambda a, b: a if a < b else b, numbers)

print(result)


# Example 5 - Concatenate Strings
words = ["Python", "is", "easy"]

result = reduce(lambda a, b: a + " " + b, words)

print(result)


# ============================================================
# 5. WHILE LOOP - 5 EXAMPLES
# ============================================================

# Example 1 - Print 1 to 5
i = 1

while i <= 5:
    print(i)
    i += 1


# Example 2 - Countdown
i = 5

while i >= 1:
    print(i)
    i -= 1


# Example 3 - Print Even Numbers
i = 2

while i <= 10:
    print(i)
    i += 2


# Example 4 - Sum of Numbers
i = 1
total = 0

while i <= 5:
    total += i
    i += 1

print(total)


# Example 5 - Password Example
password = ""

while password != "python123":
    password = input("Enter password: ")

print("Login Successful!")


# ============================================================
# 6. BREAK - 5 EXAMPLES
# ============================================================

# Example 1 - Stop at 5
for i in range(1, 10):

    if i == 5:
        break

    print(i)


# Example 2 - Find Number 3
numbers = [1, 2, 3, 4, 5]

for num in numbers:

    if num == 3:
        break

    print(num)


# Example 3 - Stop When Number is Greater Than 10
numbers = [2, 5, 8, 12, 15]

for num in numbers:

    if num > 10:
        break

    print(num)


# Example 4 - Stop at "stop"
words = ["hello", "python", "learn", "stop", "coding"]

for word in words:

    if word == "stop":
        break

    print(word)


# Example 5 - While Loop with Break
i = 1

while True:

    print(i)

    if i == 5:
        break

    i += 1


# ============================================================
# 7. CONTINUE - 5 EXAMPLES
# ============================================================

# Example 1 - Skip Number 3
for i in range(1, 6):

    if i == 3:
        continue

    print(i)


# Example 2 - Print Only Odd Numbers
for i in range(1, 11):

    if i % 2 == 0:
        continue

    print(i)


# Example 3 - Skip Negative Numbers
numbers = [10, -5, 20, -2, 30]

for num in numbers:

    if num < 0:
        continue

    print(num)


# Example 4 - Skip Empty Names
names = ["Shaikh", "", "Rahul", "", "Amit"]

for name in names:

    if name == "":
        continue

    print(name)


# Example 5 - Skip Multiples of 5
for i in range(1, 21):

    if i % 5 == 0:
        continue

    print(i)


# ============================================================
# END
# ============================================================
```

You can **copy the entire block directly into VS Code or a Jupyter Notebook**.
